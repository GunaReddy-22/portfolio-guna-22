{
  "version": 2,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "gunasai.in"
        }
      ],
      "destination": "https://admin.gunasai.in/login",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "gunasai.in"
        }
      ],
      "destination": "https://admin.gunasai.in/login",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "www.gunasai.in"
        }
      ],
      "destination": "https://admin.gunasai.in/login",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.gunasai.in"
        }
      ],
      "destination": "https://admin.gunasai.in/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.gunasai.in"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin|assets).*)",
      "destination": "/index.html"
    }
  ]
}
