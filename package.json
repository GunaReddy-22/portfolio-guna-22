{
  "name": "guna-cms",
  "version": "1.0.0",
  "description": "Guna Sai Portfolio & CMS — Frontend (Vercel) + Backend (Render)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "npm run --prefix frontend dev:portfolio",
    "dev:admin": "npm run --prefix frontend dev:admin",
    "dev:backend": "npm run --prefix backend dev",
    "build:frontend": "npm run --prefix frontend build",
    "build:backend": "npm run --prefix backend build",
    "build": "npm run --prefix frontend build && npm run --prefix backend build",
    "test:backend": "npm run --prefix backend test"
  }
}
