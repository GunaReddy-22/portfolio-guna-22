# -----------------------------------------------------------------------------
# Guna CMS — Environment Configuration Template (.env.example)
# -----------------------------------------------------------------------------

# Server Environment (development | test | production)
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Allowed Origins & Hostnames (comma-separated, HTTPS origins only in production)
# In Development:
APP_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5000
# In Production:
# APP_ORIGIN=https://gunasai.in,https://www.gunasai.in,https://admin.gunasai.in,https://forms.gunasai.in

PUBLIC_SITE_URL=https://gunasai.in
ADMIN_URL=https://admin.gunasai.in
FORMS_DOMAIN=forms.gunasai.in
FORMS_BASE_URL=https://forms.gunasai.in

# MongoDB Connection String (Atlas URI in production or local MongoDB for development)
# Production: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/guna-cms?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/guna-cms

# Session Secret (High-entropy random 32+ char string, required in production)
SESSION_SECRET=replace_with_high_entropy_32_plus_char_secret_for_production

# Preview Secret (High-entropy random 32+ char string, required in production)
PREVIEW_SECRET=replace_with_high_entropy_32_plus_char_secret_for_production

# Initial Owner Account Provisioning (Used ONLY for initial create-only provisioning via npm run seed:admin)
# Server boot NEVER alters or resets owner credentials automatically.
# Password must be at least 12 characters long.
ADMIN_EMAIL=Admin@gunasai.in
ADMIN_PASSWORD=

# Media Storage (Cloudinary - Required for durable cloud uploads in production; local storage is dev-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Delivery Configuration (Production supports: brevo | resend | sendgrid)
# Console provider is strictly prohibited in production and available in dev/test only.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_API_KEY=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=notifications@gunasai.in
