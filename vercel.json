{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.gunasai.in"
        }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin|assets).*)",
      "destination": "/index.html"
    }
  ]
}
