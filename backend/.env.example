# -----------------------------------------------------------------------------
# Guna CMS & Feedback Engine — Production Backend Environment Template (.env.example)
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Allowed Origins (HTTPS production domains only; HTTP and localhost are rejected in production)
APP_ORIGIN=https://gunasai.in,https://www.gunasai.in,https://admin.gunasai.in,https://forms.gunasai.in
PUBLIC_SITE_URL=https://gunasai.in
ADMIN_URL=https://admin.gunasai.in
FORMS_DOMAIN=forms.gunasai.in
FORMS_BASE_URL=https://forms.gunasai.in

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/guna-cms?retryWrites=true&w=majority

# High-Entropy Session & Preview Secrets (Must be 32+ cryptographically random characters in production)
SESSION_SECRET=replace_with_high_entropy_32_plus_char_secret_for_production
PREVIEW_SECRET=replace_with_high_entropy_32_plus_char_secret_for_production

# Initial Owner Account Provisioning (Used ONLY for one-time create-only provisioning via npm run seed:admin)
# Server startup NEVER alters or resets existing owner credentials automatically.
# Password must be at least 12 characters long.
ADMIN_EMAIL=Admin@gunasai.in
ADMIN_PASSWORD=

# Cloudinary Storage (Required for persistent media uploads on Render/Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Real Email Delivery Configuration (Production supports: brevo | resend | sendgrid)
# Console provider is strictly prohibited in production.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_API_KEY=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply.dev.guna@gmail.com
